# Kiwi — Elysium-native Telegram bot
# https://elysium.kinetiq.xyz — Arbitrum Orbit L2, HYPE gas, testnet chain 99801

# Telegram (get from @BotFather)
TELEGRAM_BOT_TOKEN=

# Encrypts custodial private keys at rest (AES-256-GCM). REQUIRED.
# Generate with: openssl rand -hex 32
KEY_ENCRYPTION_SECRET=

# Elysium — the only chain Kiwi runs on
ELYSIUM_CHAIN_ID=99801
ELYSIUM_RPC_URL=https://testnet-rpc.elysium.kinetiq.xyz
ELYSIUM_EXPLORER_URL=https://elysium.kinetiq.xyz/testnet-explorer

# Uniswap V2-style router for HYPE <-> ERC20 swaps on Elysium.
# Leave empty on testnet (paper trades until DEX is live). Set on mainnet.
ELYSIUM_ROUTER_ADDRESS=
ELYSIUM_WHYPE_ADDRESS=

# Kalos — Elysium NFT marketplace (https://www.kalos.fun).
# Set when Kalos publishes its marketplace contract / API.
KALOS_API_URL=
KALOS_MARKETPLACE_ADDRESS=

# Service fee (fraction; 0.025 = 2.5%)
FEE_PERCENTAGE=0.025
FEE_RECIPIENT_WALLET=

# Storage
DATA_DIR=data
DB_FILE=data/kiwi.db.json

# Alert scheduler interval in ms (default 5 minutes)
ALERT_POLL_INTERVAL_MS=300000

# Launch board remote feed (optional)
KIWI_LAUNCH_API_URL=

# Legacy (archived) — kept for env compat, unused in Elysium-only mode.
# To restore cross-chain, `git revert` the Elysium-only commit.
OPENSEA_API_KEY=
