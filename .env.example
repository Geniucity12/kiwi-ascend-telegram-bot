# Kiwi — Ascend & Elysium Launch Assistant

# Telegram
TELEGRAM_BOT_TOKEN=

# Encrypts custodial private keys at rest (AES-256-GCM). REQUIRED to create wallets.
# Generate one with: openssl rand -hex 32
KEY_ENCRYPTION_SECRET=

# Elysium (by Kinetiq) — flagship chain. Testnet is live; mainnet is pre-launch.
# https://elysium.kinetiq.xyz
ELYSIUM_CHAIN_ID=99801
ELYSIUM_RPC_URL=https://testnet-rpc.elysium.kinetiq.xyz
ELYSIUM_EXPLORER_URL=https://elysium.kinetiq.xyz/testnet-explorer

# Optional RPC overrides for other supported EVM chains
ETHEREUM_RPC_URL=https://eth.llamarpc.com
BASE_RPC_URL=https://mainnet.base.org
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
OPTIMISM_RPC_URL=https://mainnet.optimism.io
POLYGON_RPC_URL=https://polygon-rpc.com

# Service fee (fraction; 0.025 = 2.5%). Sent as a separate tx after paid mints.
FEE_PERCENTAGE=0.025
FEE_RECIPIENT_WALLET=

# OpenSea API key (optional). Enables floor prices, offers, and NFT inventory.
OPENSEA_API_KEY=

# Mint entrypoint ABI (default assumes a payable mint(uint256 quantity)).
MINT_FUNCTION_ABI=function mint(uint256 quantity) payable

# Storage
DATA_DIR=data
DB_FILE=data/kiwi.db.json

# Alert scheduler interval in ms (default 5 minutes)
ALERT_POLL_INTERVAL_MS=300000

# Launch board data source (optional). Falls back to local JSON, then seed data.
KIWI_LAUNCH_API_URL=